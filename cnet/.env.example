# Copy this file to `.env` in the project root and fill in your key.
#   cp cnet/.env.example .env
# `.env` is gitignored — never commit your real key.

# Required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional settings (defaults shown) ---

# Which model does the thinking.
# claude-opus-5   = most capable
# claude-sonnet-5 = faster and cheaper, good for practising
CNET_MODEL=claude-opus-5

# How hard it thinks before answering: low | medium | high | xhigh | max
CNET_EFFORT=medium

# What C-Net calls itself, and what it calls you.
CNET_NAME=C-Net
CNET_USER_NAME=boss

# The only folder C-Net may read or write.
CNET_WORKSPACE=~/cnet-workspace

# Let C-Net run shell commands. Off by default. Even when on, every single
# command asks for your approval first. Turn this on only when you need it.
CNET_ALLOW_SHELL=false

# Ask before writing files. Keep this on until you trust it.
CNET_CONFIRM_WRITES=true
